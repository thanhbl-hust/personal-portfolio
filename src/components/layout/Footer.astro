---
import { SITE } from '../../config';

// Launch date as DD/MM/YYYY; parsed as UTC midnight, so format it in UTC too
const launchDate = new Intl.DateTimeFormat('en-GB', {
	day: '2-digit',
	month: '2-digit',
	year: 'numeric',
	timeZone: 'UTC',
}).format(new Date(SITE.launchDate));
---

<footer class="site-footer">
	<div class="container footer">
		<p>From <time datetime={SITE.launchDate}>{launchDate}</time> {SITE.initials}</p>
		<p>
			Built with <a href="https://astro.build">Astro</a> · <a href={SITE.repo}>source</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
	}

	.footer {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 1.5rem;
		color: var(--text-muted);
		font-size: var(--text-sm);
	}

	/* Below this width the floating buttons would cover the footer's right side */
	@media (max-width: 66em) {
		.footer {
			padding-bottom: 4.5rem;
		}

		/* Post pages stack the table of contents button above BackToTop */
		:global(body:has(.toc-toggle)) .footer {
			padding-bottom: 8rem;
		}
	}
</style>
