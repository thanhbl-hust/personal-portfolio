<button class="theme-switch" type="button" role="switch" aria-checked="true" aria-label="Dark theme">
	<svg class="icon sun" viewBox="0 0 24 24" aria-hidden="true">
		<circle cx="12" cy="12" r="4"></circle>
		<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
		></path>
	</svg>
	<svg class="icon moon" viewBox="0 0 24 24" aria-hidden="true">
		<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
	</svg>
	<span class="knob" aria-hidden="true" data-keep-motion>
		<svg class="icon sun" viewBox="0 0 24 24">
			<circle cx="12" cy="12" r="4"></circle>
			<path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
			></path>
		</svg>
		<svg class="icon moon" viewBox="0 0 24 24">
			<path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
		</svg>
	</span>
</button>

<script>
	const root = document.documentElement;
	const themeSwitch = document.querySelector<HTMLButtonElement>('.theme-switch');
	const knob = themeSwitch?.querySelector<HTMLElement>('.knob');

	if (themeSwitch && knob) {
		const isDark = () => root.dataset.theme !== 'light';

		const setTheme = (theme: 'light' | 'dark') => {
			root.dataset.theme = theme;
			themeSwitch.setAttribute('aria-checked', String(theme === 'dark'));
			try {
				localStorage.setItem('theme', theme);
			} catch {}
		};

		themeSwitch.setAttribute('aria-checked', String(isDark()));

		// The knob follows the pointer while dragged, then snaps to the nearer side: left is light, right is dark
		const DRAG_THRESHOLD_PX = 3;
		let pointerId: number | undefined;
		let startX = 0;
		let startProgress = 0;
		let progress = 0;
		let dragged = false;

		const travel = () => themeSwitch.clientWidth - knob.offsetWidth - 2 * knob.offsetLeft;

		const stopDragging = () => {
			pointerId = undefined;
			themeSwitch.classList.remove('dragging');
			themeSwitch.style.removeProperty('--progress');
		};

		themeSwitch.addEventListener('pointerdown', (event) => {
			if (event.button !== 0) return;
			pointerId = event.pointerId;
			startX = event.clientX;
			startProgress = isDark() ? 1 : 0;
			dragged = false;
			themeSwitch.setPointerCapture(event.pointerId);
		});

		themeSwitch.addEventListener('pointermove', (event) => {
			if (event.pointerId !== pointerId) return;
			const dx = event.clientX - startX;
			if (!dragged && Math.abs(dx) < DRAG_THRESHOLD_PX) return;
			dragged = true;
			progress = Math.min(1, Math.max(0, startProgress + dx / travel()));
			themeSwitch.classList.add('dragging');
			themeSwitch.style.setProperty('--progress', String(progress));
		});

		themeSwitch.addEventListener('pointerup', (event) => {
			if (event.pointerId !== pointerId) return;
			stopDragging();
			if (dragged) setTheme(progress >= 0.5 ? 'dark' : 'light');
		});

		// The browser took over the gesture (e.g. to scroll): put the knob back where it was
		themeSwitch.addEventListener('pointercancel', (event) => {
			if (event.pointerId === pointerId) stopDragging();
		});

		// A tap or Enter/Space toggles; the click that ends a drag is skipped because the drag already chose
		themeSwitch.addEventListener('click', () => {
			if (dragged) {
				dragged = false;
				return;
			}
			setTheme(isDark() ? 'light' : 'dark');
		});
	}
</script>

<style>
	.theme-switch {
		--track-width: 3.5rem;
		--knob-size: 1.5rem;
		--knob-inset: 0.1875rem;
		--progress: 1;

		position: relative;
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-shrink: 0;
		width: var(--track-width);
		height: 2rem;
		/* Centers each end icon under the knob's resting spot on that side */
		padding-inline: calc(var(--knob-inset) + (var(--knob-size) - 0.875rem) / 2);
		border: 1px solid var(--border);
		border-radius: 999px;
		background-color: var(--surface);
		color: var(--text-muted);
		cursor: pointer;
		/* Horizontal drags move the knob; vertical ones still scroll the page */
		touch-action: pan-y;
		user-select: none;
		transition: border-color var(--transition);
	}

	:global([data-theme='light']) .theme-switch {
		--progress: 0;
	}

	.theme-switch:hover {
		border-color: var(--accent);
	}

	.icon {
		width: 0.875rem;
		height: 0.875rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.knob {
		position: absolute;
		top: calc(50% - var(--knob-size) / 2);
		left: var(--knob-inset);
		display: grid;
		place-items: center;
		width: var(--knob-size);
		height: var(--knob-size);
		border-radius: 50%;
		background-color: var(--accent);
		color: var(--bg);
		box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);
		/* Travel = the track's inner width (minus its 1px borders) less the knob and its inset on both sides */
		transform: translateX(
			calc(var(--progress) * (var(--track-width) - 2px - var(--knob-size) - 2 * var(--knob-inset)))
		);
		transition:
			transform var(--transition),
			background-color var(--transition);
	}

	.dragging .knob {
		transition: none;
		cursor: grabbing;
	}

	/* The knob shows the current theme's icon and covers that side's track icon, leaving the other one visible */
	.knob .moon,
	:global([data-theme='light']) .knob .sun {
		display: block;
	}

	.knob .sun,
	:global([data-theme='light']) .knob .moon {
		display: none;
	}
</style>
