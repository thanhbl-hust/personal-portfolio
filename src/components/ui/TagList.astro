---
type Tag = string | { label: string; href: string };

interface Props {
	items: readonly Tag[];
}

const { items } = Astro.props;
---

<ul class="tags">
	{
		items.map((item) =>
			typeof item === 'string' ? (
				<li class="tag">{item}</li>
			) : (
				<li>
					<a class="tag" href={item.href}>
						{item.label}
					</a>
				</li>
			),
		)
	}
</ul>

<style>
	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}

	.tag {
		display: inline-block;
		padding: 0.15rem 0.6rem;
		border: 1px solid var(--border);
		border-radius: 999px;
		background-color: var(--accent-soft);
		color: var(--heading);
		font-size: var(--text-xs);
		line-height: 1.6;
	}

	a.tag {
		transition: border-color var(--transition);
	}

	a.tag:hover {
		border-color: var(--accent);
		text-decoration: none;
	}
</style>
