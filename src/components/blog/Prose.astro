<div class="prose">
	<slot />
</div>

<!-- Styles for rendered Markdown. Code blocks are styled by Expressive Code (see astro.config.mjs). -->
<style>
	/* Vertical rhythm between top-level blocks */
	.prose > :global(* + *) {
		margin-top: 1.25rem;
	}

	/* Headings */
	.prose :global(h2),
	.prose :global(h3),
	.prose :global(h4) {
		scroll-margin-top: 5rem;
	}

	.prose > :global(h2) {
		margin-top: 3rem;
		font-size: var(--text-xl);
	}

	.prose > :global(h3) {
		margin-top: 2.25rem;
		font-size: var(--text-lg);
	}

	.prose > :global(h4) {
		margin-top: 1.75rem;
		font-size: var(--text-base);
	}

	.prose :global(h2::before),
	.prose :global(h3::before) {
		color: var(--accent);
	}

	.prose :global(h2::before) {
		content: '## ';
	}

	.prose :global(h3::before) {
		content: '### ';
	}

	/* Inline formatting */
	.prose :global(strong) {
		color: var(--heading);
	}

	.prose :global(u) {
		text-decoration-thickness: 1px;
		text-underline-offset: 0.2em;
	}

	.prose :global(del) {
		color: var(--text-muted);
	}

	.prose :global(mark) {
		padding: 0 0.2em;
		border-radius: 0.2em;
		background-color: color-mix(in srgb, var(--yellow) 30%, transparent);
		color: var(--heading);
	}

	.prose :global(:not(pre) > code) {
		padding: 0.1em 0.4em;
		border: 1px solid var(--border);
		border-radius: 0.25rem;
		background-color: var(--surface-2);
		color: var(--heading);
		font-size: 0.875em;
	}

	.prose :global(kbd) {
		padding: 0.05em 0.45em;
		border: 1px solid var(--border);
		border-bottom-width: 2px;
		border-radius: 0.25rem;
		background-color: var(--surface);
		font-family: inherit;
		font-size: 0.85em;
	}

	.prose :global(sub),
	.prose :global(sup) {
		font-size: 0.75em;
		line-height: 0;
	}

	.prose :global(a) {
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
		text-underline-offset: 0.2em;
	}

	.prose :global(a:hover) {
		text-decoration-color: var(--accent);
	}

	/* Colored text: <span class="text-red">...</span> */
	.prose :global(.text-red) {
		color: var(--red);
	}

	.prose :global(.text-green) {
		color: var(--green);
	}

	.prose :global(.text-blue) {
		color: var(--accent);
	}

	.prose :global(.text-yellow) {
		color: var(--yellow);
	}

	.prose :global(.text-purple) {
		color: var(--purple);
	}

	.prose :global(.text-muted) {
		color: var(--text-muted);
	}

	/* Lists */
	.prose :global(ul) {
		padding-left: 1.5rem;
		list-style-type: '- ';
	}

	.prose :global(ol) {
		padding-left: 1.75rem;
		list-style-type: decimal;
	}

	.prose :global(li::marker) {
		color: var(--text-muted);
	}

	.prose :global(li + li),
	.prose :global(li > ul),
	.prose :global(li > ol) {
		margin-top: 0.35rem;
	}

	.prose :global(ul.contains-task-list) {
		padding-left: 0.25rem;
		list-style: none;
	}

	.prose :global(.task-list-item input) {
		margin-right: 0.5rem;
		accent-color: var(--accent);
	}

	/* Blockquotes and callouts (> [!NOTE], > [!TIP], ...) */
	.prose :global(blockquote) {
		padding: 0.25rem 0 0.25rem 1rem;
		border-left: 3px solid var(--border);
		color: var(--text-muted);
	}

	.prose :global(blockquote > * + *) {
		margin-top: 0.75rem;
	}

	.prose :global(.callout) {
		--callout-color: var(--accent);
		padding: 0.85rem 1rem;
		border-left-color: var(--callout-color);
		border-radius: 0 var(--radius) var(--radius) 0;
		background-color: color-mix(in srgb, var(--callout-color) 10%, transparent);
		color: var(--text);
	}

	.prose :global(.callout-tip) {
		--callout-color: var(--green);
	}

	.prose :global(.callout-important) {
		--callout-color: var(--purple);
	}

	.prose :global(.callout-warning) {
		--callout-color: var(--yellow);
	}

	.prose :global(.callout-caution) {
		--callout-color: var(--red);
	}

	.prose :global(.callout-title) {
		color: var(--callout-color);
		font-size: var(--text-sm);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	/* Tables scroll horizontally on narrow screens instead of overflowing the page */
	.prose :global(table) {
		display: block;
		max-width: 100%;
		overflow-x: auto;
		border-collapse: collapse;
		font-size: var(--text-sm);
	}

	.prose :global(th),
	.prose :global(td) {
		padding: 0.5rem 0.85rem;
		border: 1px solid var(--border);
		text-align: left;
	}

	.prose :global(th) {
		background-color: var(--surface-2);
		color: var(--heading);
	}

	/* Media */
	.prose :global(img) {
		display: block;
		max-width: 100%;
		height: auto;
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.prose :global(hr) {
		margin-block: 2.5rem;
		border: none;
		border-top: 1px dashed var(--border);
	}

	/* Collapsible sections */
	.prose :global(details) {
		padding: 0.75rem 1rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
	}

	.prose :global(summary) {
		color: var(--heading);
		cursor: pointer;
	}

	.prose :global(details[open] > summary) {
		margin-bottom: 0.75rem;
	}

	.prose :global(details > * + *) {
		margin-top: 0.75rem;
	}

	/* Footnotes */
	.prose :global(.footnotes) {
		margin-top: 3rem;
		padding-top: 1.25rem;
		border-top: 1px dashed var(--border);
		color: var(--text-muted);
		font-size: var(--text-sm);
	}
</style>
