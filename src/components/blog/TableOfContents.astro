---
import { SITE } from '../../config';
import type { Heading } from '../../utils/posts';

interface Props {
	items: Heading[];
}

const { items } = Astro.props;
---

<aside class="toc">
	<button
		class="toc-toggle fab"
		type="button"
		aria-expanded="false"
		aria-controls="toc-panel"
		aria-label="Table of contents"
	>
		<svg viewBox="0 0 24 24" aria-hidden="true">
			<path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"></path>
		</svg>
	</button>

	<div class="backdrop" aria-hidden="true" data-keep-motion></div>

	<nav id="toc-panel" class="panel" aria-labelledby="toc-title" data-keep-motion>
		<div class="panel-header">
			<p id="toc-title" class="title">Table of contents</p>
			<button class="toc-close" type="button" aria-label="Close table of contents">
				<svg viewBox="0 0 24 24" aria-hidden="true">
					<path d="M18 6 6 18M6 6l12 12"></path>
				</svg>
			</button>
		</div>
		<ol class="list" lang={SITE.postLang}>
			{
				items.map((heading) => (
					<li class:list={['item', { sub: heading.depth === 3 }]}>
						<a href={`#${heading.slug}`}>{heading.text}</a>
					</li>
				))
			}
		</ol>
	</nav>
</aside>

<script>
	const toc = document.querySelector<HTMLElement>('.toc');
	const toggle = toc?.querySelector<HTMLButtonElement>('.toc-toggle');
	const close = toc?.querySelector<HTMLButtonElement>('.toc-close');
	const backdrop = toc?.querySelector<HTMLElement>('.backdrop');
	const links = [...(toc?.querySelectorAll<HTMLAnchorElement>('.list a') ?? [])];

	if (toc && toggle && close && backdrop) {
		// Narrow screens: the toggle button slides the drawer in, and the page behind it stops scrolling
		const setOpen = (open: boolean) => {
			toc.classList.toggle('open', open);
			toggle.setAttribute('aria-expanded', String(open));
			document.documentElement.classList.toggle('toc-open', open);
		};

		toggle.addEventListener('click', () => {
			setOpen(true);
			close.focus();
		});
		close.addEventListener('click', () => {
			setOpen(false);
			toggle.focus();
		});
		backdrop.addEventListener('click', () => setOpen(false));
		links.forEach((link) => link.addEventListener('click', () => setOpen(false)));

		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && toc.classList.contains('open')) {
				setOpen(false);
				toggle.focus();
			}
		});

		// Widening the window past the breakpoint turns the drawer back into a sidebar, so release the page
		matchMedia('(min-width: 85em)').addEventListener('change', (event) => {
			if (event.matches) setOpen(false);
		});

		// Highlight the section being read: the last heading scrolled past the top of the viewport
		const ACTIVE_OFFSET_PX = 120;
		const targetId = (link: HTMLAnchorElement) => decodeURIComponent(link.hash.slice(1));
		const headings = links
			.map((link) => document.getElementById(targetId(link)))
			.filter((heading): heading is HTMLElement => heading !== null);

		let frame = 0;

		const updateActive = () => {
			frame = 0;
			let current: HTMLElement | undefined;

			for (const heading of headings) {
				if (heading.getBoundingClientRect().top > ACTIVE_OFFSET_PX) break;
				current = heading;
			}

			// Short final sections may never reach the top, so the page bottom activates the last one
			const atBottom = window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
			if (atBottom && headings.length > 0) current = headings[headings.length - 1];

			links.forEach((link) => link.classList.toggle('active', targetId(link) === current?.id));
		};

		window.addEventListener(
			'scroll',
			() => {
				if (!frame) frame = requestAnimationFrame(updateActive);
			},
			{ passive: true },
		);
		updateActive();
	}
</script>

<style>
	.toc {
		--drawer-transition: 0.35s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.panel-header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 0.75rem;
	}

	.title {
		color: var(--heading);
		font-size: var(--text-sm);
		font-weight: 700;
	}

	.list {
		border-left: 1px solid var(--border);
		font-size: var(--text-sm);
	}

	.item a {
		display: block;
		margin-left: -1px;
		padding: 0.25rem 0 0.25rem 0.85rem;
		border-left: 2px solid transparent;
		color: var(--text-muted);
		line-height: 1.5;
		transition:
			color var(--transition),
			border-color var(--transition);
	}

	.item.sub a {
		padding-left: 1.75rem;
	}

	.item a:hover {
		color: var(--heading);
		text-decoration: none;
	}

	.item a.active {
		border-left-color: var(--accent);
		color: var(--accent);
	}

	/* Narrow screens: floating button above BackToTop, sliding the list in as a full-height drawer from the left */
	.toc-toggle {
		bottom: calc(4.5rem + env(safe-area-inset-bottom, 0px));
	}

	.toc-close {
		display: grid;
		place-items: center;
		flex-shrink: 0;
		width: 2rem;
		height: 2rem;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background: none;
		color: var(--text-muted);
		cursor: pointer;
		transition:
			color var(--transition),
			border-color var(--transition);
	}

	.toc-close:hover {
		color: var(--heading);
		border-color: var(--accent);
	}

	.toc-close svg {
		width: 1rem;
		height: 1rem;
		fill: none;
		stroke: currentColor;
		stroke-width: 2;
		stroke-linecap: round;
	}

	/* Visibility flips only after the slide finishes, so the closed drawer's links leave the tab order */
	.backdrop {
		position: fixed;
		inset: 0;
		z-index: 30;
		background-color: color-mix(in srgb, var(--bg) 60%, transparent);
		backdrop-filter: blur(3px);
		opacity: 0;
		visibility: hidden;
		transition:
			opacity var(--drawer-transition),
			visibility 0s linear 0.35s;
	}

	.panel {
		position: fixed;
		inset-block: 0;
		left: 0;
		z-index: 40;
		width: min(20rem, 85vw);
		overflow-y: auto;
		overscroll-behavior: contain;
		padding: 1.25rem 1.25rem calc(1.25rem + env(safe-area-inset-bottom, 0px));
		border-right: 1px solid var(--border);
		background-color: var(--surface);
		box-shadow: var(--shadow);
		transform: translateX(-100%);
		visibility: hidden;
		transition:
			transform var(--drawer-transition),
			visibility 0s linear 0.35s;
	}

	.toc.open .backdrop {
		opacity: 1;
		visibility: visible;
		transition: opacity var(--drawer-transition);
	}

	.toc.open .panel {
		transform: none;
		visibility: visible;
		transition: transform var(--drawer-transition);
	}

	:global(html.toc-open) {
		overflow: hidden;
	}

	/* Wide screens: sticky sidebar left of the article (same breakpoint as PostLayout.astro) */
	@media (min-width: 85em) {
		.toc {
			position: sticky;
			top: 5.5rem;
			max-height: calc(100vh - 7rem);
			overflow-y: auto;
		}

		.toc-toggle,
		.toc-close,
		.backdrop {
			display: none;
		}

		.panel,
		.toc.open .panel {
			position: static;
			width: auto;
			overflow: visible;
			padding: 0;
			border: none;
			background: none;
			box-shadow: none;
			transform: none;
			visibility: visible;
			transition: none;
		}
	}
</style>
