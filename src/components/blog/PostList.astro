---
import type { Post } from '../../utils/posts';
import PostCard from './PostCard.astro';

interface Props {
	posts: Post[];
}

const { posts } = Astro.props;
---

{
	posts.length === 0 ? (
		<p class="muted">No posts yet.</p>
	) : (
		<Fragment>
			<ol class="posts" data-post-list>
				{posts.map((post) => (
					<PostCard post={post} />
				))}
			</ol>
			<p class="muted" data-search-empty hidden>
				No posts match your search.
			</p>
		</Fragment>
	)
}
