---
import PostHeader from '../components/blog/PostHeader.astro';
import Prose from '../components/blog/Prose.astro';
import ReadingProgress from '../components/blog/ReadingProgress.astro';
import TableOfContents from '../components/blog/TableOfContents.astro';
import { SITE } from '../config';
import { getTocItems, type Heading, type Post } from '../utils/posts';
import BaseLayout from './BaseLayout.astro';

interface Props {
	post: Post;
	headings: Heading[];
}

const { post, headings } = Astro.props;
const tocItems = getTocItems(headings);
const hasToc = tocItems.length > 0;
---

<BaseLayout
	title={post.data.title}
	description={post.data.description}
	image={`/og/blog/${post.id}.png`}
>
	<ReadingProgress />
	<article class:list={['post', { 'has-toc': hasToc }]}>
		<div class="post-header">
			<PostHeader post={post} />
		</div>
		{
			hasToc && (
				<div class="post-toc">
					<TableOfContents items={tocItems} />
				</div>
			)
		}
		<div class="post-body" lang={SITE.postLang} data-progress-target>
			<Prose>
				<slot />
			</Prose>
		</div>
	</article>
</BaseLayout>

<style>
	/*
	 * The article stays centered at the usual content width, and the table of contents sits in the empty space to its left.
	 * 85em = 52rem content + 2 × (14rem TOC + 2.5rem gap), the narrowest screen where that space fits the TOC;
	 * keep it in sync with TableOfContents.astro. On narrower screens the TOC opens from a floating button.
	 */
	@media (min-width: 85em) {
		.post.has-toc {
			--toc-width: 14rem;
			--toc-gap: 2.5rem;

			display: grid;
			grid-template-columns: var(--toc-width) minmax(0, 1fr);
			grid-template-areas:
				'toc header'
				'toc body';
			column-gap: var(--toc-gap);
			/* Hang the TOC column outside the container so the article column keeps its width and position */
			margin-left: calc(-1 * (var(--toc-width) + var(--toc-gap)));
		}

		.post-header {
			grid-area: header;
		}

		.post-toc {
			grid-area: toc;
		}

		.post-body {
			grid-area: body;
		}
	}
</style>
